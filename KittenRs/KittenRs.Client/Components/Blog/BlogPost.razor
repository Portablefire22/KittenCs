@page "/blog/{Title}"
@using System.Runtime.InteropServices
@using System.Text.Json
@using KittenRs.Client.Data
@using Markdig
@using Markdown.ColorCode
@using Microsoft.AspNetCore.Components.Infrastructure

@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

@attribute [StreamRendering]


@if (Blog != null)
{
    <h1>@Blog.Title</h1>
    @if (Blog.Collection != null)
    {
        <small>Collection: <a href="/blog?group=@Blog.Collection">@Blog.Collection</a></small>
    }

    @if (Blog.HiatusSince > 0)
    {
        <small class="hiatus">Note: This project has been on hiatus since: <span id="date"> @(DateTimeOffset.FromUnixTimeMilliseconds(Blog.HiatusSince).ToString())</span></small>
    }
    <div class="blog">
        @((MarkupString)Result)
    </div>
}
else
{
    <h1 class="centre-text centre">Loading...</h1>
}

@code {

    [Parameter]
    public required string Title { get; set; }
    
    public BlogDto? Blog { get; set; }

    private string? _markdown = null;

    private string Result = ""; 
    
    protected override async Task OnInitializedAsync()
    {
        var isPrerendering = RuntimeInformation.ProcessArchitecture != Architecture.Wasm;
        if (isPrerendering) return;
        var resp = await HttpClient.GetAsync($"api/Blogs/{Title}");

        if (!resp.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/NotFound", true);
            return;
        }

        var options = new JsonSerializerOptions()
        {
            PropertyNamingPolicy =  JsonNamingPolicy.CamelCase,
        };
        Blog = await JsonSerializer.DeserializeAsync<BlogDto>(await resp.Content.ReadAsStreamAsync(),  options);
        if (Blog != null)
        {
            _markdown = await HttpClient.GetStringAsync($"api/Blogs/{Title}/content");
        }
        
        if (_markdown == null || Blog == null)
        {
            NavigationManager.NavigateTo("/NotFound", true);
            return;
        }

        var mark = new MarkdownPipelineBuilder().UsePipeTables().UseAdvancedExtensions().UseColorCode().Build();
        Result = Markdown.ToHtml(_markdown, mark);
        StateHasChanged();
    }

}